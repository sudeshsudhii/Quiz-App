generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth models (NextAuth compatible) ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(TEACHER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      AuthSession[]
  quizzes       Quiz[]
  presentations Presentation[]
  hostedSessions LiveSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Quiz models ----

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String

  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  questions  Question[]
  sessions   LiveSession[]

  @@index([authorId])
}

model Question {
  id              String       @id @default(cuid())
  quizId          String
  type            QuestionType @default(MULTIPLE_CHOICE)
  text            String
  imageUrl        String?
  timeLimit       Int          @default(30)  // seconds
  points          Int          @default(100)
  order           Int
  bloomLevel      BloomLevel?
  explanation     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  quiz    Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  responses ParticipantResponse[]

  @@index([quizId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  imageUrl   String?
  isCorrect  Boolean @default(false)
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ---- Presentation models ----

model Presentation {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String

  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  slides Slide[]
  sessions LiveSession[]

  @@index([authorId])
}

model Slide {
  id             String    @id @default(cuid())
  presentationId String
  type           SlideType @default(POLL)
  title          String?
  content        Json?
  order          Int
  settings       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  responses    SlideResponse[]

  @@index([presentationId])
}

// ---- Live Session models ----

model LiveSession {
  id              String        @id @default(cuid())
  joinCode        String        @unique
  status          SessionStatus @default(WAITING)
  mode            SessionMode   @default(QUIZ)
  quizId          String?
  presentationId  String?
  hostId          String
  currentQuestion Int           @default(0)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  settings        Json?

  host            User                  @relation(fields: [hostId], references: [id])
  quiz            Quiz?                 @relation(fields: [quizId], references: [id])
  presentation    Presentation?         @relation(fields: [presentationId], references: [id])
  participants    Participant[]
  responses       ParticipantResponse[]
  slideResponses  SlideResponse[]

  @@index([joinCode])
  @@index([hostId])
}

model Participant {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  emoji     String?
  score     Int      @default(0)
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())

  session   LiveSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses ParticipantResponse[]
  slideResponses SlideResponse[]

  @@index([sessionId])
}

model ParticipantResponse {
  id            String     @id @default(cuid())
  sessionId     String
  participantId String
  questionId    String
  answer        String
  isCorrect     Boolean
  confidence    Confidence @default(UNSURE)
  timeSpent     Int        // milliseconds
  points        Int        @default(0)
  answeredAt    DateTime   @default(now())

  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId, questionId])
  @@index([sessionId])
  @@index([participantId])
}

model SlideResponse {
  id            String   @id @default(cuid())
  sessionId     String
  participantId String
  slideId       String
  response      Json
  respondedAt   DateTime @default(now())

  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  slide       Slide       @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([slideId])
}

// ---- Enums ----

enum UserRole {
  TEACHER
  ADMIN
  STUDENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_TEXT
  WORD_CLOUD
  RATING_SCALE
  RANKING
  IMAGE_CHOICE
  LIVE_RACE
  QUICK_FIRE
  EMOJI_PULSE
  GRID_2X2
  PINPOINT
  WORD_DUEL
  TRUE_FALSE
  FILL_BLANK
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum SlideType {
  POLL
  WORD_CLOUD
  RATING
  RANKING
  OPEN_TEXT
  IMAGE_CHOICE
  EMOJI_PULSE
  GRID_2X2
  TITLE
  BULLETS
  QUOTE
  VIDEO
  IMAGE
  SCALE
  WHEEL
  QA
  PINPOINT
  EMBED
  DIVIDER
}

enum SessionStatus {
  WAITING
  ACTIVE
  PAUSED
  REVIEWING
  ENDED
}

enum SessionMode {
  QUIZ
  PRESENTATION
  BUZZER
}

enum Confidence {
  SURE
  UNSURE
}
