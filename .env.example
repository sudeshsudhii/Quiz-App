# Postgres connection string (e.g. Supabase "Session pooler"). Leave empty to use local JSON files in ./data.
DATABASE_URL=""

# Secret used to sign login cookies. Required in production. Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET=""

# Optional: only allow staff accounts with this email domain, e.g. college.edu
ALLOWED_EMAIL_DOMAIN=""

# Google sign-in for staff (Firebase web app config; these values are public)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Same domain as ALLOWED_EMAIL_DOMAIN; only used to hint Google's account picker
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=""
